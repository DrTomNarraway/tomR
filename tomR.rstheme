/* rs-theme-name: tomR */
/* rs-theme-is-dark: TRUE */

/* editor is black and white */
.ace_editor, .ace_editor_theme .profvis-flamegraph, .ace_editor_theme { background-color: #101010; color: #C0C0C0; }
.ace_active-line { background: #202020; } 
.ace_selection { background: #303030; }
.ace_cursor { border-left: 2px solid #505050; } 

/* comments are grey */
.ace_comment { color: #757575; }

/* keywords and constants are blue */
.ace_constant, .ace_keyword { color: #5EBCFF; }

/* TRUE, FALSE, NA, etc are purple */
.ace_constant.ace_language  { color: #D67FFF; }

/* numbers and strings are yellow */
.ace_constant.ace_numeric, .ace_string { color:#FFE97F; }

/* functions are pink */
.ace_support.ace_function { color:#FF7FED; }

/* package names are orange */
.ace_support.ace_class { color:#FF6A00; }

/* Rainbow indent lines */
.rstudio_rainbow_indent_guides .ace_line .ace_indent-guide:nth-child(7n+1){ background: linear-gradient(to left, #ed90a4bb 1px, transparent 1px, transparent); }
.rstudio_rainbow_indent_guides .ace_line .ace_indent-guide:nth-child(7n+2){ background: linear-gradient(to left, #d3a263bb 1px, transparent 1px, transparent); }
.rstudio_rainbow_indent_guides .ace_line .ace_indent-guide:nth-child(7n+3){ background: linear-gradient(to left, #99b657bb 1px, transparent 1px, transparent); }
.rstudio_rainbow_indent_guides .ace_line .ace_indent-guide:nth-child(7n+4){ background: linear-gradient(to left, #33c192bb 1px, transparent 1px, transparent); }
.rstudio_rainbow_indent_guides .ace_line .ace_indent-guide:nth-child(7n+5){ background: linear-gradient(to left, #00bdcebb 1px, transparent 1px, transparent); }
.rstudio_rainbow_indent_guides .ace_line .ace_indent-guide:nth-child(7n+6){ background: linear-gradient(to left, #94a9ebbb 1px, transparent 1px, transparent); }
.rstudio_rainbow_indent_guides .ace_line .ace_indent-guide:nth-child(7n+7){ background: linear-gradient(to left, #dc91dbbb 1px, transparent 1px, transparent); }

/* Rainbow indent fills */
.rstudio_rainbow_indent_fills .ace_line .ace_indent-guide:nth-child(7n+1){ background: linear-gradient(to left, #ed90a4bb 1px, #ed90a477 1px, #ed90a477 ); }
.rstudio_rainbow_indent_fills .ace_line .ace_indent-guide:nth-child(7n+2){ background: linear-gradient(to left, #d3a263bb 1px, #d3a26377 1px, #d3a26377 ); }
.rstudio_rainbow_indent_fills .ace_line .ace_indent-guide:nth-child(7n+3){ background: linear-gradient(to left, #99b657bb 1px, #99b65777 1px, #99b65777 ); }
.rstudio_rainbow_indent_fills .ace_line .ace_indent-guide:nth-child(7n+4){ background: linear-gradient(to left, #33c192bb 1px, #33c19277 1px, #33c19277 ); }
.rstudio_rainbow_indent_fills .ace_line .ace_indent-guide:nth-child(7n+5){ background: linear-gradient(to left, #00bdcebb 1px, #00bdce77 1px, #00bdce77 ); }
.rstudio_rainbow_indent_fills .ace_line .ace_indent-guide:nth-child(7n+6){ background: linear-gradient(to left, #94a9ebbb 1px, #94a9eb77 1px, #94a9eb77 ); }
.rstudio_rainbow_indent_fills .ace_line .ace_indent-guide:nth-child(7n+7){ background: linear-gradient(to left, #dc91dbbb 1px, #dc91db77 1px, #dc91db77 ); }
